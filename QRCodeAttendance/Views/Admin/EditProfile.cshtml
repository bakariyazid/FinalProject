@model QRCodeAttendance.Models.DTOs.Admin.UpdateAdminProfileRequestModel
@using QRCodeAttendance.Models.Enums
@{
    ViewData["Title"] = "Edit Admin Profile";
}
<main class="container py-5" style="max-width:820px">
    <section class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Edit admin profile</h1><p class="text-muted mb-0">Keep your administrator contact details current.</p></div><a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a></div>
            <form asp-action="EditProfile" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select"></select></div>
                <div class="col-md-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                <div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" rows="3" class="form-control"></textarea></div>
                <div class="col-12"><button class="btn btn-success px-4">Save changes</button></div>
            </form>
        </div>
    </section>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
