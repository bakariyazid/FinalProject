@using QRCodeAttendance.Models.DTOs.StudentDto
@model IReadOnlyList<StudentDto>
@{
    ViewData["Title"] = "My Students";
}
<style>
    .roster-page { min-height:100vh; padding:clamp(1rem,4vw,3rem); color:#edfdf8; background:linear-gradient(135deg,#0f172a,#123c3a); }
    .roster-shell { width:min(1120px,100%); margin:auto; }
    .roster-heading { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:1.5rem; }
    .roster-heading h1 { margin:0; font-size:clamp(1.6rem,4vw,2.35rem); font-weight:900; }
    .roster-heading p { margin:.35rem 0 0; color:#b7ccc8; }
    .roster-back { border:1px solid rgba(255,255,255,.25); border-radius:10px; padding:.7rem 1rem; color:#fff; text-decoration:none; font-weight:700; white-space:nowrap; }
    .student-card-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(245px,1fr)); gap:1rem; }
    .student-card { padding:1.25rem; border:1px solid rgba(255,255,255,.15); border-radius:18px; background:rgba(255,255,255,.09); box-shadow:0 18px 35px rgba(0,0,0,.18); backdrop-filter:blur(14px); transition:transform .2s ease,border-color .2s ease; }
    .student-card:hover { transform:translateY(-4px); border-color:#5eead4; }
    .student-card__top { display:flex; align-items:center; gap:.85rem; padding-bottom:1rem; margin-bottom:1rem; border-bottom:1px solid rgba(255,255,255,.12); }
    .student-avatar { flex:0 0 46px; width:46px; height:46px; display:grid; place-items:center; border-radius:50%; color:#052e2b; background:#5eead4; font-weight:900; font-size:1.1rem; }
    .student-name { margin:0; font-size:1.04rem; font-weight:800; overflow-wrap:anywhere; }
    .student-meta { margin:.15rem 0 0; color:#b7ccc8; font-size:.85rem; }
    .student-details { display:grid; gap:.7rem; }
    .student-detail { display:flex; justify-content:space-between; gap:1rem; align-items:start; }
    .student-detail span { color:#b7ccc8; font-size:.75rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
    .student-detail strong { text-align:right; overflow-wrap:anywhere; }
    .student-level { display:inline-block; padding:.25rem .55rem; border-radius:999px; color:#ccfbf1; background:rgba(45,212,191,.17); font-size:.78rem; }
    .student-empty { padding:3rem 1rem; border:1px dashed rgba(255,255,255,.3); border-radius:18px; text-align:center; color:#b7ccc8; }
    .roster-foot { display:flex; justify-content:space-between; gap:1rem; margin-top:1.3rem; color:#b7ccc8; font-size:.86rem; }
    @@media(max-width:600px) { .roster-heading,.roster-foot { align-items:flex-start; flex-direction:column; } .roster-back { width:100%; text-align:center; } }
</style>
<main class="roster-page">
  <div class="roster-shell">
    <header class="roster-heading">
      <div><h1>@ViewBag.Level Student Roster</h1><p>@ViewBag.Department department · Instructor: @(User.Identity?.Name ?? "Instructor")</p></div>
      <a asp-action="InstructorDashboard" class="roster-back">← Dashboard</a>
    </header>
    @if (Model != null && Model.Any())
    {
      <section class="student-card-grid" aria-label="Students">
      @foreach (var student in Model)
      {
        var initial = string.IsNullOrWhiteSpace(student.FullName) ? "?" : student.FullName[..1].ToUpperInvariant();
        <article class="student-card">
          <div class="student-card__top"><div class="student-avatar">@initial</div><div><h2 class="student-name">@student.FullName</h2><p class="student-meta">@student.MatricNumber</p></div></div>
          <div class="student-details">
            <div class="student-detail"><span>Gender</span><strong>@student.Gender</strong></div>
            <div class="student-detail"><span>Level</span><strong class="student-level">@student.StudentLevel.GetDescription()</strong></div>
          </div>
        </article>
      }
      </section>
    }
    else
    {
      <section class="student-empty"><h2 class="h5">No students registered yet</h2><p class="mb-0">Students in the selected level will appear here.</p></section>
    }
    <footer class="roster-foot"><span>Showing <strong>@(Model?.Count ?? 0)</strong> students</span><span>Updated @DateTime.UtcNow.ToLocalTime().ToString("MMM dd, yyyy · h:mm tt")</span></footer>
  </div>
</main>
