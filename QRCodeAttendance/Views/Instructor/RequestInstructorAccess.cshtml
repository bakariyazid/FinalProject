@using QRCodeAttendance.Models.Enums
@using Microsoft.Extensions.Localization
@using QRCodeAttendance
@inject IStringLocalizer<SharedResource> Localizer
@model QRCodeAttendance.Models.DTOs.Admin.CreateInstructorAccessRequestModel

@{
    ViewData["Title"] = Localizer["RequestInstructorAccess"];
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - QRCodeAttendance</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --request-panel: rgba(255, 255, 255, 0.95);
            --request-line: rgba(15, 23, 42, 0.12);
            --request-ink: #0f172a;
            --request-muted: #64748b;
            --request-accent: #0f766e;
        }

        body {
            min-height: 100dvh;
            background:
                linear-gradient(135deg, rgba(3, 7, 18, 0.88), rgba(15, 23, 42, 0.66)),
                url('/images/attendance-portal-bg.svg') center/cover fixed;
            color: var(--request-ink);
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .request-shell {
            min-height: calc(100dvh - var(--portal-header-height) - var(--portal-footer-height));
            width: min(1180px, calc(100% - 2rem));
            margin: 0 auto;
            display: grid;
            grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.75fr);
            align-items: center;
            gap: clamp(1rem, 4vw, 3rem);
            padding: clamp(1rem, 4vw, 3rem) 0;
        }

        .request-copy {
            color: #ffffff;
        }

        .request-kicker {
            margin: 0 0 0.5rem;
            color: #a7f3d0;
            font-size: 0.78rem;
            font-weight: 900;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .request-copy h1 {
            max-width: 720px;
            margin: 0;
            font-size: clamp(2rem, 7vw, 4.25rem);
            font-weight: 900;
            line-height: 1.02;
            letter-spacing: 0;
        }

        .request-copy p {
            max-width: 620px;
            margin: 1rem 0 0;
            color: rgba(255, 255, 255, 0.78);
            font-size: clamp(0.98rem, 2vw, 1.1rem);
            line-height: 1.7;
        }

        .request-proof {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
            max-width: 640px;
            margin-top: 1.35rem;
        }

        .request-proof span {
            min-height: 70px;
            display: flex;
            align-items: center;
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.88);
            font-weight: 800;
            padding: 0.85rem;
            backdrop-filter: blur(12px);
        }

        .request-panel {
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 8px;
            background: var(--request-panel);
            box-shadow: 0 30px 80px rgba(2, 6, 23, 0.38);
            overflow: hidden;
        }

        .request-panel__header {
            padding: 1.35rem 1.35rem 1rem;
            border-bottom: 1px solid var(--request-line);
        }

        .request-panel__header h2 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 900;
        }

        .request-panel__header p {
            margin: 0.4rem 0 0;
            color: var(--request-muted);
            line-height: 1.55;
        }

        .request-form {
            padding: 1.35rem;
        }

        .request-control {
            min-height: 48px;
            border: 1px solid var(--request-line);
            border-radius: 8px;
            color: var(--request-ink);
        }

        .request-control:focus {
            border-color: var(--request-accent);
            box-shadow: 0 0 0 0.2rem rgba(15, 118, 110, 0.14);
        }

        .request-submit {
            min-height: 50px;
            border: 0;
            border-radius: 8px;
            background: var(--request-accent);
            color: #ffffff;
            font-weight: 900;
        }

        .request-submit:hover {
            background: #115e59;
            color: #ffffff;
        }

        .request-link {
            color: var(--request-accent);
            font-weight: 900;
            text-decoration: none;
        }

        .request-link:hover {
            color: #115e59;
            text-decoration: underline;
        }

        @@media (max-width: 991.98px) {
            .request-shell {
                grid-template-columns: 1fr;
                align-items: start;
                width: min(760px, calc(100% - 1.5rem));
            }

            .request-copy {
                text-align: left;
            }
        }

        @@media (max-width: 640px) {
            body {
                background-attachment: scroll;
            }

            .request-shell {
                width: min(100% - 1rem, 520px);
                padding: 1rem 0;
            }

            .request-proof {
                grid-template-columns: 1fr;
            }

            .request-panel__header,
            .request-form {
                padding: 1rem;
            }
        }
    </style>
</head>
<body class="with-portal-chrome">
    @await Html.PartialAsync("_PortalHeader")

    <main class="request-shell">
        <section class="request-copy" aria-label="@Localizer["InstructorAccessDetails"]">
            <p class="request-kicker">@Localizer["InstructorVerification"]</p>
            <h1>@Localizer["RequestAccessHero"]</h1>
            <p>@Localizer["RequestAccessIntro"]</p>
            <div class="request-proof" aria-label="@Localizer["RequestInstructorAccess"]">
                <span>@Localizer["AdminReviewed"]</span>
                <span>@Localizer["WhatsAppCodeIssued"]</span>
                <span>@Localizer["QrSessionsEnabled"]</span>
            </div>
        </section>

        <section class="request-panel" aria-label="@Localizer["InstructorAccessRequest"]">
            <div class="request-panel__header">
                <h2>@Localizer["InstructorAccessRequest"]</h2>
                <p>@Localizer["RequestFormHint"]</p>
            </div>

            <div class="request-form">
                @if (TempData["Alert"] != null)
                {
                    var alertType = TempData["AlertType"]?.ToString() ?? "info";
                    <div class="alert alert-@alertType">
                        @TempData["Alert"]
                    </div>
                }

                <form asp-controller="Instructor" asp-action="RequestInstructorAccess" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">@Localizer["FullName"]</label>
                        <input asp-for="FullName" class="form-control request-control" placeholder="Your full name" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">@Localizer["InstructorEmail"]</label>
                        <input asp-for="Email" type="email" class="form-control request-control" placeholder="instructor@school.edu" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WhatsAppNumber" class="form-label fw-bold">@Localizer["WhatsAppNumber"]</label>
                        <input asp-for="WhatsAppNumber" type="tel" class="form-control request-control" placeholder="+234 8012345678" autocomplete="tel" />
                        <span asp-validation-for="WhatsAppNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Department" class="form-label fw-bold">@Localizer["Department"]</label>
                        <select asp-for="Department" asp-items="@Html.GetEnumSelectList(typeof(Departments))" class="form-select request-control">
                            <option value="">@Localizer["SelectDepartment"]</option>
                        </select>
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn request-submit w-100">@Localizer["SubmitRequest"]</button>
                </form>

                <div class="text-center mt-3">
                    <a asp-controller="Instructor" asp-action="RegisterInstructor" class="request-link">@Localizer["AlreadyHaveCode"]</a>
                </div>
            </div>
        </section>
    </main>

    @await Html.PartialAsync("_PortalFooter")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
