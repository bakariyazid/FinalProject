    <script>
        // Chart Implementation
        const ctx = document.getElementById('attendanceChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(sessions.Select(s => s.CourseCode))),
                datasets: [{
                    label: 'Students Present',
                    // USE THE NEW STATS PROPERTY HERE
                    data: @Html.Raw(Json.Serialize(Model.AttendanceStats)), 
                    borderColor: '#6366f1',
                    tension: 0.4,
                    fill: true,
                    backgroundColor: 'rgba(99, 102, 241, 0.1)',
                    pointBackgroundColor: '#6366f1',
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { 
                    legend: { display: false },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    y: { beginAtZero: true, grid: { display: false } },
                    x: { grid: { display: false } }
                }
            }
        });

        function generateQR(token, expiry){
            document.getElementById("qrcode").innerHTML = "";
            new QRCode(document.getElementById("qrcode"), {
                text: token,
                width: 150,
                height: 150,
                colorDark : "#0f172a",
                colorLight : "#ffffff"
            });
            startTimer(expiry);
        }

        function startTimer(expiry) {
            let end = new Date(expiry).getTime();
            if(window.timerInterval) clearInterval(window.timerInterval);
            window.timerInterval = setInterval(() => {
                let now = new Date().getTime();
                let distance = end - now;
                if (distance < 0) {
                    clearInterval(window.timerInterval);
                    document.getElementById("timer").innerText = "EXPIRED";
                    return;
                }
                let m = Math.floor(distance / (1000 * 60));
                let s = Math.floor((distance % (1000 * 60)) / 1000);
                document.getElementById("timer").innerText = `${m}m ${s}s`;
            }, 1000);
        }
    </script>
