        body {
            background-color: var(--body-bg);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #1e293b;
            margin: 0;
            display: flex;
        }

        /* SIDEBAR NAVIGATION - LOCKED */
        .sidebar {
            width: 280px;
            height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            left: 0;
            top: 0;
            padding: 2.5rem 1.5rem;
            color: white;
            z-index: 1000;
            display: flex;
            flex-direction: column;
        }

        .brand-box {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 2rem; /* Adjusted for button space */
            padding: 0 0.5rem;
            flex-shrink: 0;
        }

        .brand-box h2 {
            font-size: 1.25rem;
            white-space: nowrap; 
            margin: 0;
        }

        /* NEW BUTTON STYLE */
        .btn-create-session-sidebar {
            background: var(--accent-green);
            color: #0f172a !important;
            padding: 14px;
            border-radius: 14px;
            margin-bottom: 2.5rem;
            text-decoration: none !important;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            transition: var(--transition);
            box-shadow: 0 10px 20px rgba(74, 222, 128, 0.2);
        }

        .btn-create-session-sidebar:hover {
            transform: translateY(-3px);
            background: white;
            box-shadow: 0 15px 25px rgba(255, 255, 255, 0.1);
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.6) !important;
            padding: 12px 16px !important;
            border-radius: 12px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none !important;
            transition: var(--transition);
        }

        .nav-link:hover, .nav-link.active {
            background: rgba(255, 255, 255, 0.1);
            color: white !important;
        }

        .nav-link.active { 
            background: var(--primary) !important; 
            box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3); 
        }

        /* MAIN CONTENT AREA - FIXED MARGIN */
        .main-content {
            flex: 1;
            margin-left: 280px; 
            padding: 2.5rem;
            min-width: 0;
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
        }

        /* CARDS & CONTAINERS */
        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: var(--card-shadow);
            display: flex;
            align-items: center;
            gap: 20px;
            border: 1px solid rgba(0,0,0,0.02);
        }

        .icon-box {
            width: 56px; height: 56px;
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem;
        }

        .icon-blue { background: #e0e7ff; color: #4338ca; }
        .icon-purple { background: #f3e8ff; color: #7e22ce; }

        .analytics-container, .table-container {
            background: white;
            border-radius: 24px;
            padding: 2rem;
            box-shadow: var(--card-shadow);
            margin-bottom: 2rem;
        }

        /* QR INTERFACE */
        .qr-card {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            color: white;
            border-radius: 24px;
            padding: 2rem;
            text-align: center;
            box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.2);
        }

        .qr-placeholder {
            background: white;
            padding: 15px;
            border-radius: 20px;
            display: inline-block;
            margin: 1.5rem 0;
        }

        .badge-active { background: #dcfce7; color: #166534; padding: 6px 12px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; }
        .badge-closed { background: #fee2e2; color: #991b1b; padding: 6px 12px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; }

        @@media (max-width: 1024px) {
            .sidebar { width: 80px; padding: 2rem 1rem; }
            .sidebar span, .brand-box h2, .btn-create-session-sidebar span { display: none; }
            .main-content { margin-left: 80px; }
        }
    </style>
</head>

