@using QRCodeAttendance.Models.DTOs
@using QRCodeAttendance.Models.DTOs.Session
@using QRCodeAttendance.Models.Enums
@model InstructorDashboardDto

@{
    var sessions = Model?.RecentSessions ?? new List<SessionDto>();
    ViewData["Title"] = "Instructor Analytics";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4338ca;
            --sidebar-bg: rgba(15, 23, 42, 0.74);
            --body-bg: #eef4ff;
            --glass-bg: rgba(255, 255, 255, 0.62);
            --glass-border: rgba(255, 255, 255, 0.72);
            --text-main: #172033;
            --text-soft: #64748b;
            --card-shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
            --transition: all 0.32s cubic-bezier(0.4, 0, 0.2, 1);
            --accent-green: #4ade80;
            --accent-cyan: #22d3ee;
            --accent-rose: #fb7185;
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 10% 10%, rgba(34, 211, 238, 0.24), transparent 28rem),
                radial-gradient(circle at 92% 6%, rgba(251, 113, 133, 0.18), transparent 26rem),
                linear-gradient(135deg, #eef4ff 0%, #f8fbff 46%, #eff6ff 100%);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-main);
            margin: 0;
            display: flex;
            overflow-x: hidden;
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            width: 22rem;
            height: 22rem;
            border-radius: 999px;
            filter: blur(12px);
            opacity: 0.36;
            pointer-events: none;
            z-index: 0;
            animation: ambientFloat 12s ease-in-out infinite alternate;
        }

        body::before {
            left: 20rem;
            top: -9rem;
            background: rgba(99, 102, 241, 0.22);
        }

        body::after {
            right: -7rem;
            bottom: -7rem;
            background: rgba(74, 222, 128, 0.18);
            animation-delay: -4s;
        }

        .sidebar,
        .main-content {
            position: relative;
            z-index: 1;
        }

        .sidebar {
            width: 280px;
            height: calc(100vh - 32px);
            background: linear-gradient(160deg, rgba(15, 23, 42, 0.88), rgba(30, 41, 59, 0.68));
            position: fixed;
            left: 16px;
            top: 16px;
            padding: 2rem 1.25rem;
            color: white;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 28px;
            box-shadow: 0 28px 80px rgba(15, 23, 42, 0.28);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            animation: slideInLeft 0.7s ease both;
        }

        .brand-box {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 2rem;
            padding: 0 0.5rem;
            flex-shrink: 0;
        }

        .brand-box i {
            color: var(--accent-cyan);
            filter: drop-shadow(0 8px 18px rgba(34, 211, 238, 0.28));
        }

        .brand-box h2 {
            font-size: 1.18rem;
            white-space: nowrap;
            margin: 0;
            letter-spacing: 0;
        }

        .btn-create-session-sidebar {
            background: linear-gradient(135deg, var(--accent-green), #86efac);
            color: #0f172a !important;
            min-height: 50px;
            padding: 14px;
            border-radius: 16px;
            margin-bottom: 2.25rem;
            text-decoration: none !important;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-weight: 800;
            font-size: 0.92rem;
            transition: var(--transition);
            box-shadow: 0 18px 36px rgba(74, 222, 128, 0.25);
        }

        .btn-create-session-sidebar:hover {
            transform: translateY(-3px) scale(1.01);
            background: linear-gradient(135deg, #ffffff, #dcfce7);
            box-shadow: 0 22px 42px rgba(255, 255, 255, 0.14);
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.68) !important;
            min-height: 46px;
            padding: 12px 16px !important;
            border-radius: 15px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none !important;
            transition: var(--transition);
            border: 1px solid transparent;
        }

        .nav-link i {
            width: 18px;
            text-align: center;
        }

        .nav-link:hover,
        .nav-link.active {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.12);
            color: white !important;
            transform: translateX(3px);
        }

        .nav-link.active {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.94), rgba(34, 211, 238, 0.36)) !important;
            box-shadow: 0 16px 34px rgba(99, 102, 241, 0.28);
        }

        .main-content {
            flex: 1;
            margin-left: 312px;
            padding: 2.5rem;
            min-width: 0;
            animation: fadeRise 0.72s ease 0.08s both;
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1.25rem;
            margin-bottom: 2.25rem;
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.48);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            box-shadow: var(--card-shadow);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
        }

        .header-section h1 {
            font-size: clamp(1.45rem, 2vw, 2rem);
            letter-spacing: 0;
        }

        .header-section h3 {
            color: var(--text-soft);
            font-size: 0.98rem;
            font-weight: 600;
            margin-left: 0 !important;
        }

        .header-section .bg-white {
            background: rgba(255, 255, 255, 0.7) !important;
            border: 1px solid rgba(255, 255, 255, 0.78);
            box-shadow: 0 12px 28px rgba(99, 102, 241, 0.12) !important;
        }

        .stat-card {
            min-height: 138px;
            background: var(--glass-bg);
            border-radius: 24px;
            padding: 1.5rem;
            box-shadow: var(--card-shadow);
            display: flex;
            align-items: center;
            gap: 20px;
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            transition: var(--transition);
            animation: fadeRise 0.74s ease both;
        }

        .row .col-md-6:nth-child(2) .stat-card {
            animation-delay: 0.12s;
        }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 30px 80px rgba(15, 23, 42, 0.16);
            border-color: rgba(99, 102, 241, 0.28);
        }

        .stat-card h6 {
            color: var(--text-soft) !important;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .stat-card h2 {
            color: #0f172a;
            font-size: clamp(2rem, 5vw, 2.75rem);
            line-height: 1;
        }

        .icon-box {
            width: 62px;
            height: 62px;
            border-radius: 19px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.45rem;
            flex: 0 0 auto;
            transition: var(--transition);
        }

        .stat-card:hover .icon-box {
            transform: rotate(-4deg) scale(1.05);
        }

        .icon-blue {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.16), rgba(34, 211, 238, 0.18));
            color: var(--primary-dark);
            box-shadow: inset 0 0 0 1px rgba(99, 102, 241, 0.12);
        }

        .icon-purple {
            background: linear-gradient(135deg, rgba(244, 114, 182, 0.16), rgba(168, 85, 247, 0.16));
            color: #7e22ce;
            box-shadow: inset 0 0 0 1px rgba(168, 85, 247, 0.12);
        }

        .analytics-container,
        .table-container {
            background: var(--glass-bg);
            border-radius: 24px;
            padding: 2rem;
            box-shadow: var(--card-shadow);
            margin-bottom: 2rem;
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
        }

        .qr-card {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.9), rgba(168, 85, 247, 0.82));
            color: white;
            border-radius: 24px;
            padding: 2rem;
            text-align: center;
            box-shadow: 0 24px 70px rgba(99, 102, 241, 0.24);
            border: 1px solid rgba(255, 255, 255, 0.24);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
        }

        .qr-placeholder {
            background: rgba(255, 255, 255, 0.9);
            padding: 15px;
            border-radius: 20px;
            display: inline-block;
            margin: 1.5rem 0;
            box-shadow: 0 18px 42px rgba(15, 23, 42, 0.16);
        }

        .badge-active,
        .badge-closed {
            padding: 6px 12px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .badge-active {
            background: rgba(220, 252, 231, 0.82);
            color: #166534;
        }

        .badge-closed {
            background: rgba(254, 226, 226, 0.82);
            color: #991b1b;
        }

        @@keyframes fadeRise {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes ambientFloat {
            from {
                transform: translate3d(0, 0, 0) scale(1);
            }

            to {
                transform: translate3d(20px, 16px, 0) scale(1.08);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }

        @@media (max-width: 1024px) {
            .sidebar {
                width: 86px;
                padding: 1.75rem 0.8rem;
            }

            .sidebar span,
            .brand-box h2,
            .btn-create-session-sidebar span {
                display: none;
            }

            .brand-box,
            .btn-create-session-sidebar,
            .nav-link {
                justify-content: center;
            }

            .main-content {
                margin-left: 112px;
                padding: 2rem 1.25rem;
            }
        }

        @@media (max-width: 720px) {
            body {
                display: block;
                padding-bottom: 6rem;
            }

            .sidebar {
                width: calc(100% - 24px);
                height: auto;
                min-height: 74px;
                top: auto;
                left: 12px;
                right: 12px;
                bottom: 12px;
                padding: 0.75rem;
                border-radius: 22px;
            }

            .brand-box,
            .btn-create-session-sidebar {
                display: none;
            }

            .sidebar .nav {
                flex-direction: row !important;
                align-items: center;
                justify-content: space-between;
                gap: 0.35rem;
                height: auto !important;
            }

            .sidebar .nav-item {
                margin: 0 !important;
                flex: 1 1 0;
            }

            .sidebar .nav-link {
                min-height: 48px;
                margin: 0;
                padding: 0.7rem !important;
                justify-content: center;
            }

            .sidebar span,
            .sidebar .fa-chevron-down,
            #studentsDropdown {
                display: none !important;
            }

            .main-content {
                margin-left: 0;
                padding: 1rem;
            }

            .header-section {
                align-items: flex-start;
                border-radius: 20px;
                padding: 1.15rem;
            }

            .stat-card {
                min-height: 120px;
                padding: 1.2rem;
            }
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

